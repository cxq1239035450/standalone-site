# ===========================================
# 数据库配置
# ===========================================

# 本机开发连接 Compose 数据库，使用 5433 避免与其他项目冲突。
# Compose 中的 payload 服务会自动覆盖为 postgres:5432。
DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5433/vegetable-and-fruit-wholesale

# 本地开发时使用 PostgreSQL
# DATABASE_URL=postgresql://postgres:123456@127.0.0.1:5433/vegetable-and-fruit-wholesale

# 如果需要远程 PostgreSQL
# DATABASE_URL=postgresql://user:password@your-host:5432/database_name

# ===========================================
# 安全配置
# ===========================================

# Payload CMS JWT 加密密钥（必填）
# 本地开发：openssl rand -base64 32
# 生产环境：使用更复杂的密钥
PAYLOAD_SECRET=your-super-secret-key-change-in-production

# ===========================================
# 服务器配置
# ===========================================

# 服务器 URL（必填，用于 CORS、链接生成等）
# 开发环境
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# 生产环境示例
# NEXT_PUBLIC_SERVER_URL=https://your-domain.com

# ===========================================
# Cron 定时任务
# ===========================================
CRON_SECRET=cron-secret-key-change-in-production

# ===========================================
# 预览功能
# ===========================================
PREVIEW_SECRET=preview-secret-key-change-in-production

# 可拆卸统计接入：默认关闭，开启前在独立看板验证域名。
INSIGHTS_ENABLED=false
INSIGHTS_SITE_ID=freshconnect
INSIGHTS_READ_TOKEN=
INSIGHTS_PREVIOUS_READ_TOKEN=
NEXT_PUBLIC_INSIGHTS_ENABLED=false
NEXT_PUBLIC_INSIGHTS_SITE_ID=freshconnect
NEXT_PUBLIC_INSIGHTS_ENDPOINT=

# QQ SMTP 询盘通知：授权码不是 QQ 登录密码，切勿提交实际凭证。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# 常驻 Node/Docker 服务设 true，每分钟处理已保存的新询盘通知。
# Serverless 设 false，通过受保护的 /api/payload-jobs/run?queue=inquiry-mail 调度。
INQUIRY_EMAIL_AUTORUN=false
